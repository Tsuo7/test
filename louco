RunService.Heartbeat:Connect(function()
    if Tsuo.Player.Flying and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = LocalPlayer.Character.HumanoidRootPart
        local cam = workspace.CurrentCamera
        local ctrl = {f = 0, b = 0, l = 0, r = 0}
        
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then ctrl.f = 1 end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then ctrl.b = -1 end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then ctrl.l = -1 end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then ctrl.r = 1 end
        
        local moveDir = Vector3.new(ctrl.l + ctrl.r, 0, ctrl.f + ctrl.b)
        if moveDir ~= Vector3.new(0, 0, 0) then
            hrp.CFrame = hrp.CFrame + (cam.CFrame:VectorToWorldSpace(moveDir) * Tsuo.Player.FlySpeed)
        end
        LocalPlayer.Character.Humanoid.PlatformStand = true
        hrp.Velocity = Vector3.new(0,0,0)
    elseif not Tsuo.Player.Flying and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.PlatformStand = false
    end
end)

